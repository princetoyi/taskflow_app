# Firebase Service Account Credentials (For Admin SDK on Backend)
# Path can be absolute or relative to the repository root (e.g., taskflow_serviceAccountkey.json)
FIREBASE_SERVICE_ACCOUNT=taskflow_serviceAccountkey.json
DATABASE_URL=your-database-url

# Firebase Web Config (Required for backend POST /auth/login testing REST API and Flutter client-side setup)
FIREBASE_API_KEY="your-api-key"
FIREBASE_AUTH_DOMAIN="your-auth-domain"
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_STORAGE_BUCKET="your-storage-bucket"
FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
FIREBASE_APP_ID="your-app-id"
FIREBASE_MEASUREMENT_ID="your-measurement-id"
